{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NBTCreator data-only asset library v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "name", "version", "license", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "nbtcreator.asset-library"},
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"$ref": "#/$defs/version"},
    "license": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "minecraft": {"const": "1.20.1"},
        "app_min": {"$ref": "#/$defs/version"},
        "app_max": {"$ref": "#/$defs/version"}
      }
    },
    "assets": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/asset"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 6, "maxLength": 240, "pattern": "^[^\\\\:%?#\\u0000]+\\.json$"},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "type", "path", "sha256", "bytes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "type": {"enum": ["parametric_recipe", "component"]},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
        "category": {"type": "string", "minLength": 1, "maxLength": 80},
        "status": {"enum": ["draft", "stable", "recommended", "deprecated"]},
        "tags": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 32}},
        "requires": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
