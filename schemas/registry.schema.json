{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NBTCreator library registry v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "libraries"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "nbtcreator.asset-registry"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "libraries": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "version", "path", "manifest_sha256"],
        "properties": {
          "id": {"$ref": "library.schema.json#/$defs/id"},
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "version": {"$ref": "library.schema.json#/$defs/version"},
          "path": {"$ref": "library.schema.json#/$defs/path"},
          "manifest_sha256": {"$ref": "library.schema.json#/$defs/sha256"}
        }
      }
    }
  }
}
